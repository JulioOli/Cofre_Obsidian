  "cells": [
    {
      "cell_type": "markdown",
      "id": "auditoria-lancamentos-md",
      "metadata": {},
      "source": [
        "# Auditoria Semanal de Lancamentos (ODBC / base.csv)\n",
        "\n",
        "Este notebook serve para explorar os dados e validar as regras antes de rodar semanalmente o `scripts/auditoria_lancamentos.py`.\n",
        "\n",
        "Fluxo:\n",
        "1. Carrega o `base.csv` (delimitador `;`) e tipa datas/valores.\n",
        "2. L E `regras_auditoria.yaml`.\n",
        "3. Executa o motor de detecao e mostra os principais achados."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "notebook-config",
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "import sys\n",
        "from datetime import datetime\n",
        "from pathlib import Path\n",
        "\n",
        "_cwd = os.getcwd()\n",
        "\n",
        "# Tenta inferir a raiz do workspace a partir da localizacao do notebook\n",
        "candidates = [\n",
        "    _cwd,\n",
        "    os.path.normpath(os.path.join(_cwd, '..')),\n",
        "    os.path.normpath(os.path.join(_cwd, '..', '..')),\n",
        "]\n",
        "WORKSPACE = None\n",
        "for c in candidates:\n",
        "    if os.path.isdir(os.path.join(c, '02-Referencias')) and os.path.isdir(os.path.join(c, 'scripts')):\n",
        "        WORKSPACE = c\n",
        "        break\n",
        "\n",
        "if WORKSPACE is None:\n",
        "    raise FileNotFoundError('Nao foi possivel localizar a raiz do workspace a partir de: ' + _cwd)\n",
        "\n",
        "sys.path.append(WORKSPACE)\n",
        "\n",
        "PATH_BASE = os.path.join(WORKSPACE, '02-Referencias', 'Meus_Dados', 'base.csv')\n",
        "PATH_REGRAS = os.path.join(WORKSPACE, '02-Referencias', 'Meus_Dados', 'regras_auditoria.yaml')\n",
        "\n",
        "ref_date = datetime.now().strftime('%Y-%m-%d')\n",
        "print('ref_date:', ref_date)\n",
        "print('base.csv :', PATH_BASE)\n",
        "print('regras.yaml:', PATH_REGRAS)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "notebook-run-engine",
      "metadata": {},
      "outputs": [],
      "source": [
        "from scripts.auditoria_lancamentos import carregar_base, load_rules_yaml, executar_auditoria\n",
        "\n",
        "loaded = carregar_base(Path(PATH_BASE), reference_date=datetime.fromisoformat(ref_date).date(), ignore_migrados=True)\n",
        "rules = load_rules_yaml(Path(PATH_REGRAS))\n+        "print('Regras carregadas:', len(rules))\n",
        "\n",
        "result = executar_auditoria(loaded.df, rules, ref_date=loaded.ref_date)\n",
        "print('Total de achados:', len(result))\n",
        "\n",
        "result.head(50)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "notebook-explore-codcdc",
      "metadata": {},
      "outputs": [],
      "source": [
        "# Exploracao rapida: ver cadencia de vencimentos para uma conta\n",
        "CODCDC_EXEMPLO = '7.5.22'\n",
        "\n",
        "f = loaded.df[loaded.df['codcdc'] == CODCDC_EXEMPLO].copy()\n",
        "f['venc_mes'] = f['dt_vencimento'].dt.to_period('M').astype(str)\n",
        "\n",
        "print('Registros para codcdc', CODCDC_EXEMPLO, ':', len(f))\n",
        "\n",
        "# Contagem por mes (vencimento)\n",
        "f.groupby(['filial', 'venc_mes'], dropna=False).size().sort_values(ascending=False).head(30)"
      ]
    }
  ],
